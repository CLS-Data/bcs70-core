.Rproj.user/
.DS_Store

# runner output can contain real derived values when run against the real
# data mount - it must never be committed to this repo
output/

# personal Claude Code overrides - never committed, so one contributor
# cannot silently change the sandbox settings everyone else relies on
.claude/settings.local.json

__pycache__/
*.pyc

# the atlas's generated JSON - built by .github/workflows/pages.yml at publish
# time from bcs70/ and registry/, so committing it would only create a second
# copy that can disagree with the metadata it claims to describe.
# Run 'python3 web/build_site.py' to produce it locally.
web/data/

# Working notes, kept local — with one exception. A parent directory that is
# excluded cannot have a file re-included from inside it, so the directories
# are opened up a level at a time and only the shared page let back through.
docs/*
!docs/architecture/
docs/architecture/*
!docs/architecture/atlas-loop.html

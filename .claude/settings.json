{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "bcs70"
      ]
    },
    "enableWeakerNetworkIsolation": true
  }
}
